<nav class="app-navigation" aria-label="Основное меню">
    <div class="app-userbar">
        <strong>{{ app.user ? app.user.displayName : "Monolit" }}</strong>
        {% if app.user %}
            <form action="{{ path("app_logout") }}" method="post">
                <button type="submit">Выход</button>
            </form>
        {% endif %}
    </div>
    {% set currentPath = app.request.pathInfo %}
    <div class="app-top-tabs">
        <a class="app-top-tab {{ currentPath == path("migration_dashboard") ? "is-active" }}" href="{{ path("migration_dashboard") }}">Главная</a>
        {% for item in app_menu() %}
            {% set active = currentPath starts with item.url %}
            <a class="app-top-tab {{ active ? "is-active" }}" href="{{ item.url }}">{{ item.title }}</a>
        {% endfor %}
    </div>
    <div class="app-subtabs">
        {% for item in app_menu() %}
            {% if currentPath starts with item.url %}
                {% for child in item.children %}
                    <a class="app-subtab {{ currentPath starts with child.url ? "is-active" }}" href="{{ child.url }}">{{ child.title }}</a>
                {% endfor %}
            {% endif %}
        {% endfor %}
    </div>
</nav>
