{% extends 'base.html.twig' %}
{% block title %}Производство — {{ view.group.name }}{% endblock %}
{% block body %}
<main class="app-main warehouse-details" data-controller="warehouse" data-warehouse-csrf-value="{{ csrf_token('session') }}" data-action="invalid->warehouse#invalid:capture input->warehouse#clearValidity">
<h1><a href="{{ path('warehouse_products') }}">Склад</a> » <a href="{{ path('warehouse_group',{id:view.group.id}) }}">{{ view.group.name }}</a> » Задачи / переложка</h1><p data-warehouse-target="notice" class="warehouse-message" role="status" hidden></p>
<h2>Задачи на производство</h2>
<div class="warehouse-detail-wrap"><table class="warehouse-history-table"><thead><tr><th>№</th><th>Цвет</th><th>Пресс</th><th>Осталось</th><th>Дата</th><th>Комментарий</th>{% if is_granted('WAREHOUSE_PRODUCTION') %}<th>Выработка</th>{% endif %}</tr></thead><tbody>{% for task in view.tasks %}<tr><td>{{ task.id }}</td><td>{{ task.name }}</td><td>{{ task.press_id == 0 ? 'Литье' : task.press_id }}</td><td>{{ task.remaining }} {{ task.unit }}</td><td>{{ task.due_at ? task.due_at|date('d-m-Y') : '' }}</td><td>{{ task.comment }}</td>{% if is_granted('WAREHOUSE_PRODUCTION') %}<td><form action="{{ path('warehouse_production_complete',{id:task.id}) }}" data-action="submit->warehouse#submitOperation"><input type="hidden" name="operationId"><label>Количество: <input name="quantity" type="number" min="0.001" max="99999999.999" step="0.001" required></label><label>Смена: <select name="shift"><option value="1">1</option><option value="2">2</option></select></label><label>Дата: <input type="date" name="date" value="{{ 'now'|date('Y-m-d') }}" required></label><button type="submit" class="legacy-button">Выполнено</button><p class="warehouse-form-error" role="alert" hidden></p></form></td>{% endif %}</tr>{% else %}<tr><td colspan="7">Нет открытых задач</td></tr>{% endfor %}</tbody></table></div>
<h2 id="cover">В переложке</h2><div class="warehouse-detail-wrap"><table class="warehouse-history-table"><thead><tr><th>Дата</th><th>Цвет</th><th>Пресс</th><th>Смена</th><th>Количество</th>{% if is_granted('WAREHOUSE_ACCEPT') %}<th>Внести на склад</th>{% endif %}</tr></thead><tbody>{% for entry in view.cover %}<tr><td>{{ entry.created_at ? entry.created_at|date('d-m-Y') : '' }}</td><td>{{ entry.name }}</td><td>{{ entry.press_id == 0 ? 'Литье' : entry.press_id }}</td><td>{{ entry.shift_id }}</td><td>{{ entry.quantity }} {{ entry.unit }}</td>{% if is_granted('WAREHOUSE_ACCEPT') %}<td><form action="{{ path('warehouse_production_accept',{id:entry.id}) }}" data-action="submit->warehouse#submitOperation"><input type="hidden" name="operationId"><label>Количество: <input type="number" name="quantity" value="{{ entry.quantity }}" min="0.001" max="99999999.999" step="0.001" required></label>{% if is_granted('WAREHOUSE_BREAKDOWN') %}<select name="storage" aria-label="Склад"><option value="2">Цех</option><option value="1">Офис</option></select>{% else %}<input type="hidden" name="storage" value="2">{% endif %}<button type="submit" class="legacy-button">Добавить</button><button type="button" class="legacy-button" data-url="{{ path('warehouse_production_close',{id:entry.id}) }}" data-action="warehouse#closeCover">Закрыть переложку</button><p class="warehouse-form-error" role="alert" hidden></p></form></td>{% endif %}</tr>{% else %}<tr><td colspan="6">Нет продукции в переложке</td></tr>{% endfor %}</tbody></table></div>
</main>
{% endblock %}
