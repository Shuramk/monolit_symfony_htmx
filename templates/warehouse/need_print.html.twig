<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><title>Необходимо произвести</title>{{ importmap('app') }}<link rel="stylesheet" href="{{ asset('styles/warehouse_inventory.css') }}"></head><body class="warehouse-inventory-page" data-controller="warehouse"><div class="warehouse-inventory-toolbar"><button type="button" data-action="warehouse#print">Печатать</button></div><main class="warehouse-inventory-document"><h2>Необходимо произвести — {{ group.name }}</h2><table><thead><tr><th>№</th><th>Наименование</th><th>Кол-во</th></tr></thead><tbody>{% for product in products %}<tr><td>{{ loop.index }}</td><td>{{ group.name }} {{ product.name }}</td><td>{{ product.needed }} {{ product.unit }}</td></tr>{% else %}<tr><td colspan="3">Не выбраны товары</td></tr>{% endfor %}</tbody></table></main></body></html>
