<span class="warehouse-stock-wrapper"><button type="button" class="warehouse-detail-hint {{ kind == 'orders' ? 'warehouse-ordered' }}" data-warehouse-stock-button data-action="warehouse#toggle" aria-expanded="false" aria-controls="{{ kind }}-{{ product.id }}">{{ value }}</button>
<span id="{{ kind }}-{{ product.id }}" class="warehouse-stock-popover warehouse-detail-popover" data-warehouse-target="popover" role="dialog" aria-label="{{ kind == 'orders' ? 'В заказах' : 'В задачах на отгрузку' }}" hidden><strong>{{ group.name }} {{ product.name }}</strong><table><thead><tr><th>№ заказа</th><th>{{ kind == 'orders' ? 'Дата ближайшей отгрузки' : 'Дата отгрузки' }}</th><th>Кол-во</th></tr></thead><tbody>{% for row in rows %}<tr><td>{% if row.order_id %}<a href="{{ path('order_show',{id:row.order_id}) }}">№{{ row.order_id }}</a>{% else %}—{% endif %}</td><td>{% set date = kind == 'orders' ? row.delivery_date : row.performance_date %}{{ date ? date|date('d-m-Y') : '' }}</td><td>{{ row.quantity|number_format(2,'.',' ') }} {{ product.unit }}</td></tr>{% else %}<tr><td colspan="3">Нет {{ kind == 'orders' ? 'открытых заказов' : 'задач на отгрузку' }}</td></tr>{% endfor %}</tbody></table></span></span>
