{% extends 'base.html.twig' %}
{% block title %}Создание нового заказа — заказчик{% endblock %}
{% block body %}
<main class="app-main legacy-order-form-page order-wizard" data-controller="order-customer"
      data-order-customer-search-url-value="{{ path('order_customer_search') }}"
      data-order-customer-select-url-value="{{ path('order_draft_customer') }}"
      data-order-customer-token-value="{{ csrf_token('session') }}">
    <h3 class="legacy-order-breadcrumb"><a href="{{ path('order_list') }}">Заказы</a> » <a href="{{ path('order_list') }}">Список заказов</a> » Создание нового заказа</h3>
    {% include 'order/_wizard_summary.html.twig' %}
    <section class="order-wizard-customer">
        <h3>Информация о заказчике</h3>
        <form class="order-customer-search" data-action="submit->order-customer#search">
            <label>Имя или телефон <input type="search" maxlength="100" autocomplete="off" data-order-customer-target="query" data-action="input->order-customer#scheduleSearch" autofocus></label>
            <button type="submit">Найти</button>
            <button type="button" data-action="order-customer#showNew">Новый клиент</button>
        </form>
        <p data-order-customer-target="message" role="status" aria-live="polite"></p>
        <div data-order-customer-target="results" class="order-customer-results"></div>
        <form action="{{ path('order_customer_create') }}" class="order-customer-new" data-order-customer-target="newForm" data-action="submit->order-customer#create" hidden>
            <input type="hidden" name="_token" value="{{ csrf_token('session') }}">
            <input type="hidden" name="operationId" value="{{ operationId }}">
            <label>Имя / организация <input name="name" required maxlength="255" data-order-customer-target="name"></label>
            <label>Телефон <input name="phone" type="tel" required minlength="6" maxlength="32" data-order-customer-target="phone" data-action="input->order-customer#phoneChanged"></label>
            <div><button type="submit">Добавить и выбрать</button> <button type="button" data-action="order-customer#hideNew">Отмена</button></div>
        </form>
        <p class="error" data-order-customer-target="error" role="alert" tabindex="-1" hidden></p>
    </section>
    <div class="legacy-order-form-actions"><a href="{{ path('order_new') }}">Изменить продукцию</a></div>
</main>
{% endblock %}
