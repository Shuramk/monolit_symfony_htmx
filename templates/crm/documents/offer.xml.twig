{% macro paragraph(text, align = 'left', size = 22, bold = false, italic = false, underline = false, before = 0, after = 0) %}
{% autoescape 'html' %}
<w:p><w:pPr><w:jc w:val="{{ align }}"/><w:spacing w:before="{{ before }}" w:after="{{ after }}" w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:sz w:val="{{ size }}"/>{% if bold %}<w:b/>{% endif %}{% if italic %}<w:i/>{% endif %}{% if underline %}<w:u w:val="single"/>{% endif %}</w:rPr><w:t xml:space="preserve">{{ text }}</w:t></w:r></w:p>
{% endautoescape %}
{% endmacro %}
{% macro cell(text, width, align = 'left', bold = false) %}
{% autoescape 'html' %}
<w:tc><w:tcPr><w:tcW w:w="{{ width }}" w:type="dxa"/><w:vAlign w:val="center"/></w:tcPr>{{ _self.paragraph(text, align, 24, bold) }}</w:tc>
{% endautoescape %}
{% endmacro %}
{% autoescape 'html' %}
